@startuml activity
title Пайплайн подготовки данных

legend right
  |<back:#D6EAF8>    </back>| только при обучении |
  |<back:#FFFFFF>    </back>| при обучении и в эксплуатации |
endlegend

start
:Загрузка данных
(CSV порции + изображения или фото из API);

partition "Проверка качества" {
    :Изображение читается, меньшая сторона >= 120 px;
    #D6EAF8:Разметка: 68 точек, без NaN;
    #D6EAF8:Точки в кадре, стороны не перепутаны;
    :Лицо найдено, IOD >= 30 px;
    if (критичные нарушения?) then (да)
        :Отклонить, записать в отчет;
        stop
    else (нет)
    endif
}

partition "Очистка" {
    #D6EAF8:Обрезать точки по границе кадра (выход <= 2 px);
    #D6EAF8:Удалить дубли разметки, сгруппировать копии одного фото;
    :Выровнять поворот по линии глаз;
}

partition "Признаки" {
    :yaw, roll, открытость рта, размер лица;
    :Индексы носа и рта, асимметрия;
    :Флаги пригодности: |yaw| < 0.10, рот закрыт;
}

if (режим?) then (обучение)
    #D6EAF8:Разбиение train/val по группам фото;
    #D6EAF8:Обучение, логирование в MLflow;
    #D6EAF8:Экспорт модели в ONNX;
else (эксплуатация)
    :Предсказание точек (ONNX Runtime);
endif

:Сохранение
(DVC remote, предсказания, отчет о качестве);
stop
@enduml
