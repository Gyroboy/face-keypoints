@startuml c4_context
!include <C4/C4_Context>
HIDE_STEREOTYPE()

title C4. Уровень 1: контекст системы

Person(spec, "Специалист клиники", "Загружает фото клиента, проверяет точки, получает индексы пропорций")
Person(admin, "Администратор / ML-инженер", "Обновляет данные и модель, следит за показателями")

System(sys, "Система анализа лица", "Ставит 8 ключевых точек и считает индексы пропорций и симметрии")

System_Ext(app, "Клиентское приложение", "Веб-интерфейс клиники")
System_Ext(src, "Источник новых порций", "Новые снимки с разметкой (batch_*.csv + изображения)")

Rel(spec, app, "Загружает фото, правит точки, смотрит отчет")
Rel(app, sys, "Фото -> точки и индексы, правки специалиста", "HTTPS / JSON")
Rel(src, sys, "Новые порции данных", "файлы, DVC")
Rel(admin, sys, "Запуск пайплайна, обучение, мониторинг показателей")

@enduml
